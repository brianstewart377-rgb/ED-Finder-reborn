# Fetch Spansh's system state files and load them (deploy/state_refresh.py).
# Started once a night by edfinder-state-refresh.timer.
[Unit]
Description=ED-Finder: refresh system state from Spansh
# After the weekly full backup, if one is still running: this job needs a
# table to itself for a moment, and the backup holds them all (see
# edfinder-backup-full.service).
After=docker.service network-online.target edfinder-backup-full.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/edfinder/state_refresh.py run
# Be gentle with the machine: this is background work.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3h
# When the run ends, well or badly, tell healthchecks.io, which emails the
# owner about a failure or a night with no word (deploy/report_in.py). It
# does nothing until the check's address has been saved on the machine, and
# it cannot make the job fail (the dash).
ExecStopPost=-/usr/bin/python3 /opt/edfinder/report_in.py state-refresh
