# Fetch Spansh's file of recent changes to the galaxy (the 7-day file, or the
# 32-day file after a longer gap) and apply it (deploy/galaxy_update.py).
# Started twice a day by edfinder-galaxy-update.timer. When Spansh has published
# nothing new there is nothing to apply. With scoring switched on
# (EDFINDER_GALAXY_SCORES=on in deploy.conf) each run then gives new scores to
# the systems on the waiting list, whether or not there was anything to apply.
[Unit]
Description=ED-Finder: bring the galaxy up to date from Spansh
# After the weekly full backup, if one is still running: this job needs a
# table to itself for a moment, and the backup holds them all (see
# edfinder-backup-full.service).
After=docker.service network-online.target edfinder-state-refresh.service edfinder-backup-full.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/edfinder/galaxy_update.py run
# Be gentle with the machine: this is background work.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
# When the run ends, well or badly, tell healthchecks.io, which emails the
# owner about a failure or a night with no word (deploy/report_in.py). It
# does nothing until the check's address has been saved on the machine, and
# it cannot make the job fail (the dash).
ExecStopPost=-/usr/bin/python3 /opt/edfinder/report_in.py galaxy-update
