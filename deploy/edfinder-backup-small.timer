# Every night at 02:30 UTC: an hour before the system state refresh (03:30
# UTC), so the night's backup is of the day as it ended. It takes a minute.
[Unit]
Description=ED-Finder: back up what users have written, and the settings

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
# If the machine was off at the time, run once it is back.
Persistent=true

[Install]
WantedBy=timers.target
