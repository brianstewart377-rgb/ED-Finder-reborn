# Back up the whole database in one file (deploy/backup.py full). Tens of
# gigabytes and a few hours. Started once a week by edfinder-backup-full.timer.
#
# A full backup reads every table for hours, and while it does no job can
# have a table to itself. The nightly state refresh needs that for a moment,
# and would wait behind the backup with everything that reads that table
# waiting behind it. So the two never run side by side: the nightly jobs wait
# for this one (After= this unit in theirs), and backup.py waits for a
# nightly job that is running, for 8 hours at most.
#
# To start one by hand, do it through systemd, so the nightly jobs wait
# their turn:   sudo systemctl start edfinder-backup-full.service
[Unit]
Description=ED-Finder: back up the whole database
# Not after the nightly jobs: they wait for this one, and waiting both ways
# is a loop systemd refuses to start (22 November 2026). backup.py waits
# for a nightly job that is running instead.
After=docker.service
# When a backup has ended well, run Find's usual first searches once: it has
# read every table, so they are slow until then (edfinder-find-warmup.service).
OnSuccess=edfinder-find-warmup.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/edfinder/backup.py full
# Be gentle with the machine: this is background work.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Up to 8 hours waiting for a nightly job (backup.py), then up to 12 for the
# backup itself: systemd counts the wait as part of the start. The first full
# backup took 3 hours 25 minutes. Until 22 November 2026 this was 12 hours in
# all, wait included.
TimeoutStartSec=20h
# When the run ends, well or badly, tell healthchecks.io (see the small
# backup's unit).
ExecStopPost=-/usr/bin/python3 /opt/edfinder/report_in.py backup-full
