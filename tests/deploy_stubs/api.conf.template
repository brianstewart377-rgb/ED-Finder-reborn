# Stand-in for the API, used only to test the deploy tool.
server {
    listen 8000;
    default_type application/json;
    location = /api/health {
        return 200 '{"status":"ok","database":"${STUB_DATABASE}","build_sha":"${STUB_BUILD_SHA}"}';
    }
    location = /api/v1/auth/session {
        return 200 '{"authenticated":false,"user":null}';
    }
    location = /openapi.json {
        return 200 '{"paths":{"/api/health":{},"/api/v1/auth/session":{}}}';
    }
    location = /api/archetypes/rankings {
        return 200 '${STUB_FIND_ANSWER}';
    }
    location = /api/local/search {
        return 200 '${STUB_FIND_ANSWER}';
    }
}
