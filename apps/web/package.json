{
  "name": "@ed-finder/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json --coverage.reporter=json-summary --coverage.reporter=lcov --coverage.reportOnFailure --maxWorkers=2",
    "shared:build": "tsc -p ../../packages/api-client/tsconfig.build.json && tsc -p ../../packages/planner-core/tsconfig.build.json",
    "shared:check": "tsc -p ../../packages/api-client/tsconfig.json && tsc -p ../../packages/planner-core/tsconfig.json",
    "shared:lint": "node scripts/lint-shared.mjs",
    "shared:test": "cd ../.. && apps/web/node_modules/.bin/vitest run --config apps/web/vitest.shared.config.ts",
    "test:e2e": "cypress run --browser chrome",
    "test:map-diagnostics": "cypress run --browser chrome --config-file cypress.map-diagnostics.config.ts",
    "map:nebulae": "node scripts/build-nebula-asset.mjs",
    "generate:api": "svelte-kit sync && node scripts/capture-openapi.mjs && openapi-ts && openapi-typescript .svelte-kit/openapi.json -o ../../packages/api-client/src/generated/api.gen.ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "4.1.0",
    "axe-core": "4.12.1",
    "cypress": "15.21.1",
    "cypress-axe": "1.7.0",
    "eslint": "10.9.1",
    "eslint-plugin-svelte": "3.23.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "openapi-typescript": "7.13.0",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "@babylonjs/core": "9.23.0",
    "@ed-finder/api-client": "file:../../packages/api-client",
    "@ed-finder/planner-core": "file:../../packages/planner-core",
    "@lucide/svelte": "1.37.0",
    "@tanstack/svelte-query": "6.1.48",
    "json-with-bigint": "3.5.11"
  }
}
