{
  "about": "The Explore galaxy map (Almanac's). Type Sol and fly to it; pick a result; zoom, move, turn and tilt; choose a star on the map itself; type Colonia and fly right across the map; back out to the whole galaxy.",
  "path": "/explore",
  "ready": { "selector": "[data-galaxy-map=\"ready\"]", "timeoutSeconds": 90 },
  "probe": [
    { "selector": ".selection-status", "attributes": ["data-map-showing", "data-map-stars"] },
    { "selector": ".gm-hud", "attributes": ["data-panel"] }
  ],
  "requests": { "under": "/api/" },
  "steps": [
    { "do": "wait", "name": "whole-galaxy", "seconds": 5 },

    { "do": "type", "name": "type-sol", "selector": "#system-search", "text": "Sol", "shot": false, "settleSeconds": 0.2 },
    { "do": "waitFor", "name": "suggestions-for-sol", "selector": "[role=\"listbox\"] [role=\"option\"]", "timeoutSeconds": 15, "settleSeconds": 0.5 },
    { "do": "keys", "name": "choose-sol", "key": "ArrowDown", "times": 1, "seconds": 0.3, "shot": false, "settleSeconds": 0.1 },
    { "do": "keys", "name": "fly-to-sol-start", "key": "Enter", "times": 1, "seconds": 0.2, "settleSeconds": 0.2 },
    { "do": "wait", "name": "fly-to-sol-middle", "seconds": 0.8, "settleSeconds": 0 },
    { "do": "waitFor", "name": "stars-near-sol", "selector": ".selection-status[data-map-stars=\"ready\"]", "timeoutSeconds": 30, "settleSeconds": 0 },
    { "do": "wait", "name": "fly-to-sol-arrived", "seconds": 4, "settleSeconds": 0 },

    { "do": "waitFor", "name": "results-near-sol", "selector": "[data-system-result]", "timeoutSeconds": 30, "settleSeconds": 2 },
    { "do": "click", "name": "fly-to-a-result-start", "selector": "[data-result-select]", "settleSeconds": 0.3 },
    { "do": "wait", "name": "fly-to-a-result-arrived", "seconds": 4, "settleSeconds": 0 },

    { "do": "move", "name": "pointer-on-the-map", "at": [0.62, 0.56], "shot": false, "settleSeconds": 0.3 },
    { "do": "wheel", "name": "zoom-out-a-little", "deltaY": 200, "ticks": 6, "seconds": 3, "at": [0.62, 0.56] },
    { "do": "wheel", "name": "zoom-in-again", "deltaY": -200, "ticks": 6, "seconds": 3, "at": [0.62, 0.56] },
    { "do": "hold", "name": "move-right", "key": "d", "seconds": 2 },
    { "do": "hold", "name": "move-forward", "key": "w", "seconds": 2 },
    { "do": "hold", "name": "turn", "key": "q", "seconds": 2 },
    { "do": "drag", "name": "turn-and-tilt-with-left-button", "from": [0.62, 0.5], "to": [0.7, 0.38], "seconds": 2 },
    { "do": "drag", "name": "move-with-right-button", "from": [0.7, 0.5], "to": [0.55, 0.6], "seconds": 2, "button": "right" },
    { "do": "click", "name": "centre-on-the-system", "selector": "[data-map-camera=\"chosen\"]", "settleSeconds": 4 },

    { "do": "type", "name": "type-colonia", "selector": "#system-search", "text": "Colonia", "shot": false, "settleSeconds": 0.2 },
    { "do": "waitFor", "name": "suggestions-for-colonia", "selector": "[role=\"listbox\"] [role=\"option\"]", "timeoutSeconds": 15, "settleSeconds": 0.5 },
    { "do": "keys", "name": "choose-colonia", "key": "ArrowDown", "times": 1, "seconds": 0.3, "shot": false, "settleSeconds": 0.1 },
    { "do": "keys", "name": "fly-to-colonia-start", "key": "Enter", "times": 1, "seconds": 0.2, "settleSeconds": 0.2 },
    { "do": "wait", "name": "fly-to-colonia-middle-1", "seconds": 0.7, "settleSeconds": 0 },
    { "do": "wait", "name": "fly-to-colonia-middle-2", "seconds": 0.7, "settleSeconds": 0 },
    { "do": "wait", "name": "fly-to-colonia-arrived", "seconds": 5, "settleSeconds": 0 },

    { "do": "click", "name": "hide-the-finder", "selector": "[data-finder-panel-hide]", "settleSeconds": 2 },
    { "do": "wheel", "name": "zoom-out-1", "deltaY": 200, "ticks": 15, "seconds": 4, "at": [0.5, 0.56] },
    { "do": "wheel", "name": "zoom-out-2", "deltaY": 200, "ticks": 25, "seconds": 5, "at": [0.5, 0.56] },
    { "do": "click", "name": "whole-galaxy-again", "selector": "[data-map-camera=\"galaxy\"]", "settleSeconds": 5 }
  ]
}
