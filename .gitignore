# Local scratch clones / promotion worktrees kept outside git history
_promote_chip/
_promote_main_cleanup/

# Generated artifact outputs; keep durable receipts, ignore disposable binaries
artifacts/frontend-bundles/*.tar.gz
artifacts/frontend-bundles/*.tar.gz.sha256
artifacts/restore-rehearsals/latest.dump

# Local, non-product side project (CAD/3D); not part of the repo
artifacts/mouse-house/

# Tool and session artifacts
.mcp.json
.superpowers/
# Some Windows tooling has historically flattened an absolute Superpowers path
# into a single root filename (for example C:Users...superpowerssddtask-1-diff.patch).
# Keep that malformed scratch output out of tracked repo root as well.
/C*Users*ed-finder.superpowerssdd*
ed-finder-deployed.png
ed-finder-finder-page.png
tools/

# uv: only apps/api/uv.lock is authoritative. Ignore a stray root-level lock
# (anchored so apps/api/uv.lock stays tracked — never use a bare `uv.lock`).
/uv.lock

# Tool caches not otherwise covered
.ruff_cache/

# Local browser/test scratch dirs (their contents currently collapse via
# *.log/*.db/*.pyc rules, but the directories themselves are not ignored)
chrome-artifact/
.edge-headless/
.tmp-r1-scan/

# Claude Code runtime lock
.claude/scheduled_tasks.lock

# Transient CI / Review Lab failure artifacts downloaded into the working tree
artifacts/firefox-fail-*/
artifacts/review-lab-fail/
/review-report-artifact*/

# Governed production purge admission helpers are committed operator code.
!scripts/operator/lib/
!scripts/operator/lib/v3_purge_state.py
!scripts/operator/lib/v3-purge-state.sh
