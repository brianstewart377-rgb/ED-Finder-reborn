# ── Carve-outs: the Python-style `lib/` ignore above unfortunately
#    matches `frontend/src/lib/{api,format}.ts` (used heavily by the
#    React app). Without these re-includes, fresh checkouts fail to
#    build the v2 app with "Cannot find module '@/lib/api'".
!frontend/src/lib/
!frontend/src/lib/**
!frontend/src/_redesign/lib/
!frontend/src/_redesign/lib/**
!apps/web/src/lib/
!apps/web/src/lib/**
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

